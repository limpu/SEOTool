# =============================================================================
# AI SEO Intelligence Platform — environment variable template
# =============================================================================
#
# HOW TO USE THIS FILE
#   1. Copy it:  cp .env.example .env
#   2. Fill in the values marked REQUIRED.
#   3. Restart the application. (Editing .env does NOT reload a running
#      process — Next.js reads the environment once, at start.)
#
# You do not have to do this by hand. The web installer at /install will
# walk you through every variable below, check each one, generate the
# secrets, and write this file for you on a traditional/VPS deployment.
# See docs/INSTALL.md.
#
# NEVER commit the real .env to version control, never place it in a
# public/ or static/ directory, and never serve it over HTTP.
#
# -----------------------------------------------------------------------------
# THE THREE LABELS USED BELOW
# -----------------------------------------------------------------------------
#   REQUIRED   The application refuses to start without it.
#   OPTIONAL   Leaving it unset is a supported, honest state — the affected
#              feature reports itself as "not configured" instead of failing.
#              (Some OPTIONAL values become REQUIRED in production; that is
#              stated on each one.)
#   GENERATED  A cryptographic secret. Do NOT invent a value by hand and do
#              NOT reuse one from another deployment or from documentation.
#              Generate it with the exact command shown, or let the installer
#              generate it for you.
#
# -----------------------------------------------------------------------------
# ROTATION WARNINGS — READ BEFORE CHANGING ANY GENERATED VALUE
# -----------------------------------------------------------------------------
# GSC_TOKEN_ENCRYPTION_KEY and GA4_TOKEN_ENCRYPTION_KEY encrypt the stored
# Google refresh tokens at rest. There is NO KEY VERSIONING in this codebase:
# a stored ciphertext carries no key id, so nothing can fall back to an older
# key. Changing either value makes every already-connected Search Console /
# Analytics property PERMANENTLY undecryptable. The failure does not appear
# immediately — it appears at the next token refresh, possibly hours later.
# The only recovery is for every affected user to disconnect and re-authorise
# with Google. Set these once, before real connections exist.
#
# JWT_SECRET signs session cookies AND the OAuth `state` parameter for both
# Google flows. Changing it signs every user out (recoverable) and breaks any
# authorisation handshake already in flight with an opaque "invalid state"
# error. After changing it, sign in again and re-test BOTH the Search Console
# and the Analytics connect flows before considering the change finished.
#
# =============================================================================


# -----------------------------------------------------------------------------
# DATABASE
# -----------------------------------------------------------------------------

# REQUIRED — PostgreSQL connection string. This is the platform's only hard
# runtime dependency; nothing works without it. PostgreSQL 18 or newer.
# Percent-encode any @ : / # or ? in the password ("@" becomes "%40") —
# an unencoded special character is the most common cause of a connection
# string that will not parse.
DATABASE_URL=postgresql://seo_user:CHANGE_ME@localhost:5432/seo_platform


# -----------------------------------------------------------------------------
# APPLICATION
# -----------------------------------------------------------------------------

# GENERATED, REQUIRED — signs session cookies and the Google OAuth state
# token. Minimum 32 characters. See the rotation warning above.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=GENERATE_ME_DO_NOT_USE_THIS_PLACEHOLDER

# OPTIONAL in development, REQUIRED in production — turns on production
# hardening: Secure session cookies, real email delivery, Next.js
# optimisations. One of: development | production | test.
NODE_ENV=production

# OPTIONAL in development, REQUIRED in production — the public origin of this
# installation, used for password-reset links and every server-generated
# absolute URL. Full origin, no trailing slash.
#
# IMPORTANT: this value is inlined into the browser bundle at BUILD time.
# Changing it needs a REBUILD, not just a restart. In Docker, pass it as
# `--build-arg NEXT_PUBLIC_APP_URL=https://seo.example.com`.
NEXT_PUBLIC_APP_URL=https://seo.example.com

# OPTIONAL — how long a login lasts, in seconds. Defaults to 604800 (7 days).
SESSION_DURATION_SECONDS=604800


# -----------------------------------------------------------------------------
# EMAIL / SMTP
# Delivers registration OTPs, password resets and email-change confirmations.
# OPTIONAL for local development (messages are printed to the server console
# instead). REQUIRED in production — without it, nobody can register, verify
# an address, or recover a password.
# -----------------------------------------------------------------------------

# OPTIONAL / REQUIRED in production — SMTP server hostname.
EMAIL_HOST=smtp.example.com

# OPTIONAL / REQUIRED in production — SMTP port.
# 587 with EMAIL_SECURE=false (STARTTLS, most common), or
# 465 with EMAIL_SECURE=true (implicit TLS). Mismatching the pair produces a
# "wrong version number" TLS error.
EMAIL_PORT=587

# OPTIONAL — whether SMTP uses implicit TLS. Compared against the literal
# string "true"; any other value means false. Pair with EMAIL_PORT above.
EMAIL_SECURE=false

# OPTIONAL / REQUIRED in production — SMTP username.
EMAIL_USER=no-reply@example.com

# OPTIONAL / REQUIRED in production — SMTP password.
# For Gmail or Microsoft 365 this must be an APP PASSWORD, not the account
# password. Never share this file after filling this in.
EMAIL_PASS=CHANGE_ME_APP_PASSWORD

# OPTIONAL — the From address on outgoing mail. Has a working default.
EMAIL_FROM="AI SEO Platform <no-reply@example.com>"


# -----------------------------------------------------------------------------
# GOOGLE — SEARCH CONSOLE AND ANALYTICS 4
# OPTIONAL as a group. Leave the whole group unset and both integrations show
# an honest "not configured" state. Set it PARTIALLY and the feature fails at
# run time — configure all of it, or none of it.
#
# Both integrations share ONE Google Cloud OAuth client, with two separately
# registered redirect URIs and two independent encryption keys.
#
# Google matches redirect URIs by EXACT STRING. A trailing slash, a missing
# "www", or http instead of https is a mismatch, and the resulting
# `redirect_uri_mismatch` error does not say which. Google also requires
# HTTPS for production OAuth.
# -----------------------------------------------------------------------------

# OPTIONAL — OAuth 2.0 Client ID. Google Cloud Console →
# APIs & Services → Credentials → OAuth 2.0 Client IDs (type: Web application).
# Must end in .apps.googleusercontent.com
GOOGLE_CLIENT_ID=000000000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com

# OPTIONAL — OAuth 2.0 Client secret for the client ID above.
GOOGLE_CLIENT_SECRET=CHANGE_ME_GOOGLE_CLIENT_SECRET

# OPTIONAL — Search Console callback. Must end in /api/gsc/callback and must
# be registered verbatim in the Google Cloud Console.
GOOGLE_OAUTH_REDIRECT_URI=https://seo.example.com/api/gsc/callback

# OPTIONAL — Analytics 4 callback. A SECOND redirect URI on the SAME OAuth
# client. Must end in /api/ga4/callback and be registered verbatim.
GOOGLE_GA4_OAUTH_REDIRECT_URI=https://seo.example.com/api/ga4/callback

# GENERATED, OPTIONAL — AES-256-GCM key encrypting stored Search Console
# refresh tokens. Must decode to EXACTLY 32 bytes.
# See the rotation warning at the top of this file: changing this permanently
# destroys every existing Search Console connection.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
GSC_TOKEN_ENCRYPTION_KEY=GENERATE_ME_32_BYTES_BASE64

# GENERATED, OPTIONAL — the same thing for Analytics 4. INDEPENDENT from the
# Search Console key by design, so rotating one never affects the other.
# The same permanent-destruction warning applies.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
GA4_TOKEN_ENCRYPTION_KEY=GENERATE_ME_32_BYTES_BASE64


# -----------------------------------------------------------------------------
# LOCAL AI (OLLAMA)
# OPTIONAL. Unset, every AI feature reports "AI analysis unavailable" rather
# than crashing or inventing a result. Nothing is sent to a third-party API.
# -----------------------------------------------------------------------------

# OPTIONAL — which AI provider to use. "ollama" is the only one implemented.
# Defaults to "ollama" when unset.
AI_PROVIDER=ollama

# OPTIONAL — where Ollama is listening. Defaults to http://localhost:11434.
# In Docker, localhost is the container itself — use the service name or
# http://host.docker.internal:11434.
OLLAMA_BASE_URL=http://localhost:11434

# OPTIONAL — the exact model name you pulled (e.g. `ollama pull llama3.2`).
# There is deliberately NO default: guessing a model name would produce a
# confusing runtime failure instead of an honest "not configured".
OLLAMA_MODEL=llama3.2


# -----------------------------------------------------------------------------
# PAGESPEED / LIGHTHOUSE
# -----------------------------------------------------------------------------

# OPTIONAL — explicit path to a real Chrome/Chromium binary. PageSpeed audits
# launch a real browser; they do not bundle one.
# The supplied Dockerfile installs Chromium and sets this to /usr/bin/chromium
# automatically, so you only need this on a traditional/VPS install where
# Chrome is somewhere non-standard. Unset, PageSpeed is simply unavailable —
# crawling, the rule engines, Search Console, Analytics and reporting all
# work without it.
PAGESPEED_CHROME_PATH=/usr/bin/chromium
