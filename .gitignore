# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the template, which contains only placeholders and must ship with
# the source so a new deployment knows which variables exist.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Web Installer (Stage 1) — the install token is a credential: it proves
# filesystem/container-log access and can create the first SUPER_ADMIN while
# installation is not yet complete. It is generated per-deployment at boot and
# must never be committed.
.install-token

# database backups
database/backups/*.dump
database/backups/*.sql

# IDE / temp
.claude/
*.log

